<?xml version="1.0" encoding="utf-8"?>
<!-- T5-4 音高×共鸣双通道图解(自制,无内嵌文字):左=只升音高、共鸣掉队 → 两线错位(红,太监音警示);
     右=音高与共鸣两线同升(绿,对)。紫线=音高,粉线=共鸣。
     配文见 strings.xml:training_illus_t5_s4_desc -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="160dp"
    android:viewportWidth="240"
    android:viewportHeight="160">

    <!-- 左:错位(mismatch) -->
    <path
        android:fillColor="#FFF3F0"
        android:strokeColor="#E53935"
        android:strokeWidth="2"
        android:pathData="M16,28 h100 a10,10 0 0,1 10,10 v84 a10,10 0 0,1 -10,10 h-100 a10,10 0 0,1 -10,-10 v-84 a10,10 0 0,1 10,-10 z" />
    <!-- 音高线:上行到高位 -->
    <path
        android:pathData="M18,66 L40,66 L52,52 L74,52 L86,38 L114,38"
        android:strokeColor="#7E57C2"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 共鸣线:停在低位 -->
    <path
        android:pathData="M18,112 L52,110 L86,109 L114,108"
        android:strokeColor="#F06292"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 错位间隙(双向红箭头) -->
    <path
        android:pathData="M104,44 v58"
        android:strokeColor="#E53935"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M104,44 l-4.5,8 h9 z"
        android:fillColor="#E53935" />
    <path
        android:pathData="M104,102 l-4.5,-8 h9 z"
        android:fillColor="#E53935" />
    <!-- 叉号 -->
    <path
        android:pathData="M26,44 l10,10 M36,44 l-10,10"
        android:strokeColor="#E53935"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 右:同升(对齐) -->
    <path
        android:fillColor="#F1F8E9"
        android:strokeColor="#43A047"
        android:strokeWidth="2"
        android:pathData="M124,28 h100 a10,10 0 0,1 10,10 v84 a10,10 0 0,1 -10,10 h-100 a10,10 0 0,1 -10,-10 v-84 a10,10 0 0,1 10,-10 z" />
    <!-- 音高线:上行 -->
    <path
        android:pathData="M126,110 L148,94 L162,78 L178,62 L222,44"
        android:strokeColor="#7E57C2"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 共鸣线:同步上行 -->
    <path
        android:pathData="M126,122 L148,108 L162,94 L178,78 L222,60"
        android:strokeColor="#F06292"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <!-- 对勾 -->
    <path
        android:pathData="M198,38 l8,10 l16,-20"
        android:strokeColor="#43A047"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
